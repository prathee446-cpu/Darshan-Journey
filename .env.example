# ═══════════════════════════════════════════════════════════════
# Darshan Journey — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and configure your production/testing credentials.

# ─── Server Port & API URL ───
PORT=5000
# Optional: explicitly set API URL if frontend is hosted on a different domain
# VITE_API_URL=http://localhost:5000

# ─── Google OAuth 2.0 Credentials ───
# How to get Google Client ID:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Click "Create Credentials" → "OAuth Client ID" → Select "Web Application"
# 3. Under "Authorized JavaScript origins", add:
#    - http://localhost:3000
#    - http://localhost:5173 (if using default vite port)
#    - https://yourproductiondomain.com
# 4. Under "Authorized redirect URIs", add:
#    - http://localhost:3000/login
# 5. Copy the generated Client ID and paste below:
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ─── Real Email OTP via Gmail SMTP ───
# How to get Gmail App Password:
# 1. Enable 2-Factor Authentication on your Google/Gmail account:
#    https://myaccount.google.com/security
# 2. Go to Google App Passwords:
#    https://myaccount.google.com/apppasswords
# 3. Create a new App Password (App Name: "Darshan Journey")
# 4. Copy the generated 16-character password (without spaces) and paste below:
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# ─── MongoDB Atlas Database ───
# MongoDB connection URI (Atlas cloud cluster or local mongodb instance)
MONGODB_URI=mongodb+srv://darshan_user:DarshanJourney2026@cluster0.mongodb.net/darshan_journey_db?retryWrites=true&w=majority
DATABASE_NAME=darshan_journey_db

# ─── JWT Authentication Secret ───
JWT_SECRET_KEY=darshan_journey_secret_jwt_key_2026_sacred_temple_app

# ─── Optional Real-Time Web Search API Keys ───
# TAVILY_API_KEY=tvly-xxxxxxxxxxxx
# WEB_SEARCH_API_KEY=
