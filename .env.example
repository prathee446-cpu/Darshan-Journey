# ═══════════════════════════════════════════════════════════════
# Darshan Journey — Local Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Instructions:
# 1. Copy this file to create your local .env file:
#    cp .env.example .env
# 2. Populate the required configuration values below with your credentials.
# 3. Never commit .env to Git (it is ignored by .gitignore).
# ═══════════════════════════════════════════════════════════════

# ─── 1. Server Port & Network Setup ───
PORT=5000
# Optional: explicitly set if frontend and backend are hosted on differing domains
# VITE_API_URL=http://localhost:5000

# ─── 2. Google OAuth 2.0 Credentials ───
# Frontend Google Client ID (Must be prefixed with VITE_ for Vite bundling)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Backend Google Client ID & Secret
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ⚠️ CRITICAL GOOGLE CLOUD CONSOLE REQUIREMENT:
# In https://console.cloud.google.com/apis/credentials:
# Under your OAuth 2.0 Web Client -> "Authorized JavaScript origins":
# You MUST add:
#   - http://localhost:3000
#   - http://localhost:5173
# Under "Authorized redirect URIs":
#   - http://localhost:3000/login
# Accessing the app on any other origin/port will trigger "origin_mismatch".

# ─── 3. Gmail SMTP Credentials (Required for Login & Registration OTPs) ───
# Primary variable names:
SMTP_EMAIL=your_email_address@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
# Sender display name shown in email client (defaults to "Darshan Journey"):
SMTP_FROM_NAME="Darshan Journey"

# Supported aliases (if your environment uses these variable names instead):
# EMAIL_USER=your_email_address@gmail.com
# EMAIL_PASS=your_16_char_google_app_password

# How to generate Gmail 16-character App Password:
# 1. Enable 2-Step Verification on your Google account: https://myaccount.google.com/security
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password with App Name: "Darshan Journey"
# 4. Copy the generated 16-character code (spaces will be automatically stripped) into SMTP_PASSWORD/EMAIL_PASS.
# (Do NOT use your normal Google account password).

# Optional custom SMTP host & port (defaults to Gmail port 465):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ─── 4. MongoDB Database Connection ───
# Connection URI (MongoDB Atlas or local MongoDB instance mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<database_name>?retryWrites=true&w=majority
DATABASE_NAME=darshan_journey_db

# ─── 5. JWT Authentication & Session Security ───
# Secret key used for signing session tokens
JWT_SECRET_KEY=your_secure_random_jwt_secret_phrase_here
# Supported alias:
# JWT_SECRET=your_secure_random_jwt_secret_phrase_here
JWT_EXPIRES_IN=7d
